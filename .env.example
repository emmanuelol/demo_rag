# ══════════════════════════════════════════════════════════════════════════════
# demo_rag — Environment Configuration
# SOLID: Interface Segregation Principle — config is grouped by deployment target.
# Copy this file to .env and fill in ONLY the section matching DEPLOYMENT_ENV.
# ══════════════════════════════════════════════════════════════════════════════

# ── DEPLOYMENT SWITCH ─────────────────────────────────────────────────────────
# Toggle between 'local' (Ollama + Qdrant) and 'gcp' (Vertex AI + Cloud Search)
# Default: local — no cloud credentials required
DEPLOYMENT_ENV=local


# ══════════════════════════════════════════════════════════════════════════════
# LOCAL STACK (DEPLOYMENT_ENV=local)
# Requires: Docker, NVIDIA Container Toolkit (optional — CPU fallback available)
# ══════════════════════════════════════════════════════════════════════════════

# Network & Storage
DATASETS_DIR=./datasets
MODELS_DIR=./models

# Ports
JUPYTER_PORT=8888
GRADIO_SERVER_PORT=7860
PHOENIX_PORT=6006

# Ollama configuration (local inference engine)
BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.2

# Qdrant vector database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=demo_collection

# FastEmbed model cache (shared between host and container)
FASTEMBED_CACHE_DIR=./fastembed_cache

# Embedding and inference models (local)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INFERENCE_MODEL=qwen2.5:7b-fenced


# ══════════════════════════════════════════════════════════════════════════════
# GCP STACK (DEPLOYMENT_ENV=gcp)
# Required ONLY when DEPLOYMENT_ENV=gcp. Leave commented for local runs.
# Requires: GCP project with Vertex AI API enabled, ADC credentials
# ══════════════════════════════════════════════════════════════════════════════

# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=us-central1
# GOOGLE_API_KEY=your-google-api-key
# VERTEX_AI_ENDPOINT=your-vertex-ai-endpoint

# GCP model overrides (optional — defaults are set in config.yaml)
# GCP_LLM_MODEL=gemini-1.5-pro
# GCP_EMBEDDING_MODEL=text-embedding-004


# ══════════════════════════════════════════════════════════════════════════════
# OBSERVABILITY (both stacks)
# Phoenix OTLP telemetry — optional, system runs fine without it
# ══════════════════════════════════════════════════════════════════════════════

# Phoenix telemetry endpoint
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# OTEL_EXPORTER_OTLP_TIMEOUT=500  # ms — non-blocking guarantee
